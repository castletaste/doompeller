# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# A pure-Dart package run through `flutter test` drops a build/ directory next
# to its pubspec. Those are throwaway harness assets, never sources.
packages/*/build/
packages/*/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Doompeller: developer-only local content. Never commit WAD data or anything
# extracted from a commercial IWAD.
.local/
*.wad
*.WAD
*.iwad
*.IWAD
*.pwad
*.PWAD
*.deh
*.DEH
/assets/shaders/*.shaderbundle
/artifacts/
